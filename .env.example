# 接应端令牌：不设置时 /api/relay/admin 与 /api/relay/notify 一律返回 503
RELAY_CONSOLE_TOKEN=

# 家属转达：阿里云短信（四项齐全时优先于 Twilio，需先报备模板）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
# 模板变量名 → 本系统字段映射，按你报备的模板变量名改
ALIYUN_SMS_TEMPLATE_PARAMS={"ref":"ref","name":"name","verify":"verify","place":"place","state":"state"}
# 仅用于自建网关或本地联调，生产留空
ALIYUN_SMS_API_BASE=

# 家属转达：Twilio 三项齐全时优先直发
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 仅用于自建网关或本地联调，生产留空
TWILIO_API_BASE=

# 通用短信/邮件网关（Twilio 未配置时生效）
SMS_WEBHOOK_URL=

# 新求助推送（对接机构工单系统，可选）
RELAY_WEBHOOK_URL=

# 记录留存天数，默认 90
RELAY_RETENTION_DAYS=
